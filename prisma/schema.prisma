// Reference Prisma Schema for HUNRUTECH (PostgreSQL / Supabase on Vercel)
// Note: Live AI Studio runtime persists via Firebase Firestore + Express API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum ProjectCategory {
  SOFTWARE
  CLI_AUTOMATION
  WEB_APPS
}

enum CollabType {
  OPEN_SOURCE_CONTRIBUTION
  JOINT_VENTURE
  CLIENT_PROJECT
  SECURITY_RESEARCH
}

enum CollabStatus {
  PENDING
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum PresetCategory {
  DARAJA
  PAYSTACK
  SUPABASE
  CUSTOM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  summary      String
  category     ProjectCategory
  version      String
  techStack    String[]
  repoUrl      String?
  demoUrl      String?
  cloneCommand String?
  imageUrl     String?
  featured     Boolean         @default(false)
  visible      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category, visible])
}

model CollaborationRequest {
  id             String       @id @default(cuid())
  referenceId    String       @unique
  name           String
  portfolioUrl   String?
  contact        String
  collabType     CollabType
  techStack      String[]
  pitch          String
  status         CollabStatus @default(PENDING)
  adminNotes     String       @default("")
  publicResponse String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([referenceId])
}

model ApiPreset {
  id          String         @id @default(cuid())
  name        String
  category    PresetCategory
  method      HttpMethod
  url         String
  headersJson String         @default("{}")
  bodyJson    String         @default("")
  description String?
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model SiteSettings {
  id                   String   @id @default("global")
  announcementText     String   @default("")
  announcementActive   Boolean  @default(false)
  maintenanceMode      Boolean  @default(false)
  proxyRateLimitPerMin Int      @default(30)
  smtpRateLimitPerMin  Int      @default(6)
  enabledDevTools      String[]
  updatedAt            DateTime @updatedAt
}

model ApiTestLog {
  id         String     @id @default(cuid())
  protocol   String
  method     HttpMethod?
  targetHost String
  statusCode Int?
  latencyMs  Int
  success    Boolean
  createdAt  DateTime   @default(now())

  @@index([createdAt])
}
